# ==========================================================================
# Files Git should ignore completely.
# Anything listed here is never committed and never pushed to GitHub.
# ==========================================================================

# --- Python -------------------------------------------------------------
# The virtual environment: thousands of library files, specific to THIS
# machine. Anyone cloning the repo rebuilds it from requirements.txt.
backend/venv/
venv/
.venv/

# Compiled Python, generated automatically and never edited by hand.
__pycache__/
*.py[cod]
*.egg-info/

# --- Database -----------------------------------------------------------
# Contains real user rows and password hashes. Never put this on GitHub.
# Run `python seed.py` to recreate demo data instead.
*.db
*.sqlite
*.sqlite3

# --- Node / React -------------------------------------------------------
# node_modules can hold tens of thousands of files. package.json and
# package-lock.json are enough to rebuild it exactly.
node_modules/
frontend/node_modules/

# Production build output, regenerated by `npm run build`.
dist/
build/
frontend/dist/

# --- Secrets ------------------------------------------------------------
# Anything holding API keys, passwords or tokens.
.env
.env.*
!.env.example

# --- Editors and OS -----------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---------------------------------------------------------------
*.log
npm-debug.log*
